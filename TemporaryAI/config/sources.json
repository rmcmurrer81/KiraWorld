{
  "version": "1.1",
  "purpose": "Define raw source folders for Kira's library and TemporaryAI source processing. Raw sources live in Kira/Data/library and extracted evidence is written elsewhere.",
  "rules": {
    "source_files_are_external_knowledge": true,
    "do_not_treat_as_personal_memory": true,
    "raw_sources_are_read_only": true,
    "dedupe_by": "sha256_file_hash",
    "auto_scan_new_files": true,
    "manual_corrections_override_auto_detection": true,
    "canon_sources_process_before_fanfic": true,
    "fanfic_never_overwrites_canon": true,
    "reading_a_file_does_not_equal_memory": true
  },
  "source_sets": {
    "miraculous_canon_scripts": {
      "description": "Canon script/transcript library for Miraculous Ladybug source processing.",
      "source_folders": [
        "Kira/Data/library/scripts/miraculous_ladybug"
      ],
      "file_patterns": [
        "*.pdf",
        "*.txt",
        "*.md"
      ],
      "recursive": true,
      "auto_scan": true,
      "source_authority": "canon",
      "content_format": "script_or_transcript",
      "locked_sources": [],
      "tags": [
        "series:miraculous_ladybug",
        "source_authority:canon",
        "type:script",
        "temporary_ai_source"
      ]
    },
    "miraculous_fanfic_stories": {
      "description": "Fanfic/story library for Miraculous Ladybug variant processing. These files are scanned as optional variant material only.",
      "source_folders": [
        "Kira/Data/library/stories/fanfic/miraculous_ladybug"
      ],
      "file_patterns": [
        "*.txt",
        "*.md",
        "*.pdf"
      ],
      "recursive": true,
      "auto_scan": true,
      "source_authority": "fanfic_variant",
      "content_format": "story_prose",
      "locked_sources": [],
      "tags": [
        "series:miraculous_ladybug",
        "source_authority:fanfic_variant",
        "type:story",
        "temporary_ai_variant_source",
        "requires_review"
      ]
    }
  },
