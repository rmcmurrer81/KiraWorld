# Local/runtime state
__pycache__/
.pytest_cache/
*.py[cod]
*.log
*.pid
*.tmp
tmp*/
_tmp*

# Builds and large assets
*.exe
*.obj
*.dll
*.lib
*.pdb
*.blend
*.blend1
*.glb
*.gltf
*.usdz
*.fbx
*.stl
*.wav
*.mp3
*.mp4
*.mkv
*.png
*.jpg
*.jpeg
*.webp
*.pdf
*.docx
*.zip
*.7z

# Resident/private and model stores are intentionally outside this snapshot.
Data/
Memory/
TemporaryAI/
Models/
private_owner_reviews/
private_owner_review/
private_review/
node_modules/

# Curated, allowlisted private-team mirror. The sync tool copies only the
# approved source paths into this tree; no broad Data/TemporaryAI unignore is
# permitted.
!private_delivery/
!private_delivery/**

# Approved System/Docs PDFs are also visible in their expected repository path.
!System/Docs/*.pdf
!System/Docs/**/*.pdf

# Curated root-layout mirrors. Only reviewed paths are staged explicitly.
!Assets/
!Assets/**
!Avatar/
!Avatar/**
!Data/
!Data/**
!Kira/
!Kira/**
!Lisa/
!Lisa/**
!System/
!System/**
!TemporaryAI/
!TemporaryAI/**
!Voice/
!Voice/**

# Resident Avatar Builder memory is mutable/private runtime state, not source.
# Keep this final rule after the curated Avatar re-includes above.
Avatar/avatar_builder/builder_memory.json
