<?xml version="1.0"?>
<package format="3">
  <name>kira_intent_interfaces</name>
  <version>0.2.0</version>
  <description>Bounded high-level intention messages for Kira World simulator-first robotics integration.</description>
  <maintainer email="rmcmurrer@kiralabs.org">Robert McMurrer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
