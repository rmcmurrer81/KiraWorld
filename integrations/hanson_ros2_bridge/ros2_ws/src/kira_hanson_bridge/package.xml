<?xml version="1.0"?>
<package format="3">
  <name>kira_hanson_bridge</name>
  <version>0.2.0</version>
  <description>Simulator authority and bounded intention bridge for Kira World and future Hanson Robotics interfaces.</description>
  <maintainer email="rmcmurrer@kiralabs.org">Robert McMurrer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>kira_intent_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
